{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mysterycases.app/schemas/case.schema.json",
  "title": "Mystery Cases serialized case",
  "description": "Portable, versioned data contract consumed by loadSerializedCase().",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "intro", "difficulty", "rows", "columns", "zones", "objects", "board", "characters", "solution"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/nonEmptyString" },
    "title": { "$ref": "#/$defs/nonEmptyString" },
    "intro": { "$ref": "#/$defs/nonEmptyString" },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "rows": { "type": "integer", "minimum": 1 },
    "columns": { "type": "integer", "minimum": 1 },
    "zones": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/zone" } },
    "objects": { "type": "array", "items": { "$ref": "#/$defs/boardObject" } },
    "board": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/boardCell" } },
    "characters": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/character" } },
    "solution": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/placement" } },
    "globalClues": { "type": "array", "items": { "$ref": "#/$defs/globalClue" } },
    "edgeFeatures": { "type": "array", "items": { "$ref": "#/$defs/edgeFeature" } },
    "traitDefinitions": { "type": "array", "items": { "$ref": "#/$defs/traitDefinition" } }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "assetKey": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$" },
    "position": {
      "type": "object",
      "required": ["row", "column"],
      "properties": {
        "row": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "zoneLabelAnchor": {
      "type": "object",
      "required": ["position"],
      "properties": {
        "position": { "$ref": "#/$defs/position" },
        "placement": { "enum": ["top", "center", "bottom"] }
      },
      "additionalProperties": false
    },
    "zone": {
      "type": "object",
      "required": ["id", "name", "tone"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "tone": { "$ref": "#/$defs/nonEmptyString" },
        "iconAsset": { "$ref": "#/$defs/assetKey" },
        "surface": { "$ref": "#/$defs/zoneSurface" },
        "labelAnchor": { "$ref": "#/$defs/zoneLabelAnchor" }
      },
      "additionalProperties": false
    },
    "zoneSurface": {
      "enum": ["tile", "kitchenTile", "grass", "stairs", "asphalt", "wood", "carpet", "industrial", "concrete", "generic"]
    },
    "objectAppearance": {
      "enum": [
        "sunLounger", "toilet", "diningChair", "officeChair", "sofa", "bathtub", "outdoorBench", "stool",
        "wheelchair", "cafeCounter", "coffeeMachine", "roundTable", "workbench", "tires", "meetingTable", "lockerBank", "lifeguardChair", "shoppingCart", "cinemaSeatRow", "projector", "readingTable", "vendingMachine", "ticketCounter", "gymBench", "treadmill", "dumbbells", "displayCase", "restorationTable", "piano", "dressingTable", "coatRack", "stageSpotlight", "freezer", "poolSurface",
        "securityScanner", "baggageConveyor", "checkinKiosk", "departureBench", "luggageDrone",
        "specimenTank", "xenoLabBench", "sampleAnalyzer", "containmentPod", "decontaminationArch",
        "cargoLoader", "magneticPallet", "freightConsole", "sealedContainer", "maintenanceUnit",
        "hydroponicBed", "growTower", "nutrientTank", "irrigationConsole", "harvestCart",
        "assemblyLine", "roboticArm", "androidPod", "calibrationStation", "partsTrolley",
        "lunarDrill", "oreCart", "oreCrusher", "surveyConsole", "pressureLocker", "lunarExcavation"
      ]
    },
    "objectFootprint": {
      "type": "object",
      "required": ["id", "positions"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "positions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/position" } }
      },
      "additionalProperties": false
    },
    "boardObject": {
      "type": "object",
      "required": ["id", "label", "iconAsset", "occupiable"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "iconAsset": { "$ref": "#/$defs/assetKey" },
        "occupiable": { "type": "boolean" },
        "appearance": { "$ref": "#/$defs/objectAppearance" },
        "visualProfile": { "enum": ["compact", "standard", "wide", "tall"] },
        "footprint": { "$ref": "#/$defs/objectFootprint" },
        "occupiablePositions": { "type": "array", "items": { "$ref": "#/$defs/position" } }
      },
      "additionalProperties": false
    },
    "boardCell": {
      "type": "object",
      "required": ["row", "column", "zoneId", "occupiable"],
      "properties": {
        "row": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "zoneId": { "$ref": "#/$defs/nonEmptyString" },
        "occupiable": { "type": "boolean" },
        "objectId": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "clueBase": {
      "type": "object",
      "required": ["id", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "text": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "clue": {
      "oneOf": [
        { "$ref": "#/$defs/rowClue" },
        { "$ref": "#/$defs/columnClue" },
        { "$ref": "#/$defs/zoneClue" },
        { "$ref": "#/$defs/onObjectClue" },
        { "$ref": "#/$defs/besideObjectClue" },
        { "$ref": "#/$defs/northOfCharacterClue" },
        { "$ref": "#/$defs/southOfCharacterClue" },
        { "$ref": "#/$defs/sameZoneAsCharacterClue" },
        { "$ref": "#/$defs/besideCharacterClue" },
        { "$ref": "#/$defs/notZoneClue" },
        { "$ref": "#/$defs/notOnObjectClue" },
        { "$ref": "#/$defs/notBesideObjectClue" },
        { "$ref": "#/$defs/rowOffsetFromCharacterClue" },
        { "$ref": "#/$defs/cornerOfBoardClue" },
        { "$ref": "#/$defs/cornerOfZoneClue" },
        { "$ref": "#/$defs/besideWallClue" },
        { "$ref": "#/$defs/notBesideWallClue" },
        { "$ref": "#/$defs/besideEdgeFeatureClue" },
        { "$ref": "#/$defs/notBesideEdgeFeatureClue" },
        { "$ref": "#/$defs/withTraitInZoneClue" },
        { "$ref": "#/$defs/withoutTraitInZoneClue" },
        { "$ref": "#/$defs/companionTraitCountClue" },
        { "$ref": "#/$defs/oneOfZonesClue" },
        { "$ref": "#/$defs/oneOfObjectsClue" },
        { "$ref": "#/$defs/aloneInZoneClue" },
        { "$ref": "#/$defs/notAloneInZoneClue" },
        { "$ref": "#/$defs/ownZoneOccupancyCountClue" },
        { "$ref": "#/$defs/sameColumnAsObjectClue" },
        { "$ref": "#/$defs/relativeToObjectClue" },
        { "$ref": "#/$defs/onSurfaceClue" }
      ]
    },
    "rowClue": { "allOf": [{ "$ref": "#/$defs/clueBase" }, { "type": "object", "required": ["type", "row"], "properties": { "type": { "const": "row" }, "row": { "type": "integer", "minimum": 1 } } }], "unevaluatedProperties": false },
    "columnClue": { "allOf": [{ "$ref": "#/$defs/clueBase" }, { "type": "object", "required": ["type", "column"], "properties": { "type": { "const": "column" }, "column": { "type": "integer", "minimum": 1 } } }], "unevaluatedProperties": false },
    "zoneClue": { "$ref": "#/$defs/zoneClueShape", "unevaluatedProperties": false },
    "notZoneClue": { "allOf": [{ "$ref": "#/$defs/clueBase" }, { "type": "object", "required": ["type", "zoneId"], "properties": { "type": { "const": "notZone" }, "zoneId": { "$ref": "#/$defs/nonEmptyString" } } }], "unevaluatedProperties": false },
    "zoneClueShape": { "allOf": [{ "$ref": "#/$defs/clueBase" }, { "type": "object", "required": ["type", "zoneId"], "properties": { "type": { "const": "zone" }, "zoneId": { "$ref": "#/$defs/nonEmptyString" } } }] },
    "onObjectClue": { "$ref": "#/$defs/onObjectClueShape", "unevaluatedProperties": false },
    "onObjectClueShape": { "allOf": [{ "$ref": "#/$defs/clueBase" }, { "type": "object", "required": ["type", "objectId"], "properties": { "type": { "const": "onObject" }, "objectId": { "$ref": "#/$defs/nonEmptyString" } } }] },
    "besideObjectClue": { "allOf": [{ "$ref": "#/$defs/clueBase" }, { "type": "object", "required": ["type", "objectId"], "properties": { "type": { "const": "besideObject" }, "objectId": { "$ref": "#/$defs/nonEmptyString" } } }], "unevaluatedProperties": false },
    "notOnObjectClue": { "allOf": [{ "$ref": "#/$defs/clueBase" }, { "type": "object", "required": ["type", "objectId"], "properties": { "type": { "const": "notOnObject" }, "objectId": { "$ref": "#/$defs/nonEmptyString" } } }], "unevaluatedProperties": false },
    "notBesideObjectClue": { "allOf": [{ "$ref": "#/$defs/clueBase" }, { "type": "object", "required": ["type", "objectId"], "properties": { "type": { "const": "notBesideObject" }, "objectId": { "$ref": "#/$defs/nonEmptyString" } } }], "unevaluatedProperties": false },
    "northOfCharacterClue": { "$ref": "#/$defs/northOfCharacterClueShape", "unevaluatedProperties": false },
    "northOfCharacterClueShape": { "allOf": [{ "$ref": "#/$defs/clueBase" }, { "type": "object", "required": ["type", "targetCharacterId"], "properties": { "type": { "const": "northOfCharacter" }, "targetCharacterId": { "$ref": "#/$defs/nonEmptyString" } } }] },
    "southOfCharacterClue": { "allOf": [{ "$ref": "#/$defs/clueBase" }, { "type": "object", "required": ["type", "targetCharacterId"], "properties": { "type": { "const": "southOfCharacter" }, "targetCharacterId": { "$ref": "#/$defs/nonEmptyString" } } }], "unevaluatedProperties": false },
    "sameZoneAsCharacterClue": { "allOf": [{ "$ref": "#/$defs/clueBase" }, { "type": "object", "required": ["type", "targetCharacterId"], "properties": { "type": { "const": "sameZoneAsCharacter" }, "targetCharacterId": { "$ref": "#/$defs/nonEmptyString" } } }], "unevaluatedProperties": false },
    "besideCharacterClue": { "allOf": [{ "$ref": "#/$defs/clueBase" }, { "type": "object", "required": ["type", "targetCharacterId"], "properties": { "type": { "const": "besideCharacter" }, "targetCharacterId": { "$ref": "#/$defs/nonEmptyString" } } }], "unevaluatedProperties": false },
    "rowOffsetFromCharacterClue": { "allOf": [{ "$ref": "#/$defs/clueBase" }, { "type": "object", "required": ["type", "targetCharacterId", "rowOffset"], "properties": { "type": { "const": "rowOffsetFromCharacter" }, "targetCharacterId": { "$ref": "#/$defs/nonEmptyString" }, "rowOffset": { "type": "integer", "not": { "const": 0 } } } }], "unevaluatedProperties": false },
    "cornerOfBoardClue": { "$ref": "#/$defs/cornerOfBoardClueShape", "unevaluatedProperties": false },
    "cornerOfBoardClueShape": { "allOf": [{ "$ref": "#/$defs/clueBase" }, { "type": "object", "required": ["type"], "properties": { "type": { "const": "cornerOfBoard" } } }] },
    "cornerOfZoneClue": { "allOf": [{ "$ref": "#/$defs/clueBase" }, { "type": "object", "required": ["type"], "properties": { "type": { "const": "cornerOfZone" } } }], "unevaluatedProperties": false },
    "besideWallClue": { "allOf": [{ "$ref": "#/$defs/clueBase" }, { "type": "object", "required": ["type"], "properties": { "type": { "const": "besideWall" } } }], "unevaluatedProperties": false },
    "notBesideWallClue": { "allOf": [{ "$ref": "#/$defs/clueBase" }, { "type": "object", "required": ["type"], "properties": { "type": { "const": "notBesideWall" } } }], "unevaluatedProperties": false },
    "besideEdgeFeatureClue": { "$ref": "#/$defs/besideEdgeFeatureClueShape", "unevaluatedProperties": false },
    "besideEdgeFeatureClueShape": { "allOf": [{ "$ref": "#/$defs/clueBase" }, { "type": "object", "required": ["type", "featureType"], "properties": { "type": { "const": "besideEdgeFeature" }, "featureType": { "enum": ["window", "door"] } } }] },
    "notBesideEdgeFeatureClue": { "allOf": [{ "$ref": "#/$defs/clueBase" }, { "type": "object", "required": ["type", "featureType"], "properties": { "type": { "const": "notBesideEdgeFeature" }, "featureType": { "enum": ["window", "door"] } } }], "unevaluatedProperties": false },
    "withTraitInZoneClue": { "$ref": "#/$defs/withTraitInZoneClueShape", "unevaluatedProperties": false },
    "withTraitInZoneClueShape": { "allOf": [{ "$ref": "#/$defs/clueBase" }, { "type": "object", "required": ["type", "traitId"], "properties": { "type": { "const": "withTraitInZone" }, "traitId": { "$ref": "#/$defs/nonEmptyString" } } }] },
    "withoutTraitInZoneClue": { "allOf": [{ "$ref": "#/$defs/clueBase" }, { "type": "object", "required": ["type", "traitId"], "properties": { "type": { "const": "withoutTraitInZone" }, "traitId": { "$ref": "#/$defs/nonEmptyString" } } }], "unevaluatedProperties": false },
    "companionTraitCountClue": { "allOf": [{ "$ref": "#/$defs/clueBase" }, { "type": "object", "required": ["type", "traitId", "count"], "properties": { "type": { "const": "companionTraitCount" }, "traitId": { "$ref": "#/$defs/nonEmptyString" }, "count": { "type": "integer", "minimum": 1 } } }], "unevaluatedProperties": false },
    "oneOfZonesClue": { "allOf": [{ "$ref": "#/$defs/clueBase" }, { "type": "object", "required": ["type", "zoneIds"], "properties": { "type": { "const": "oneOfZones" }, "zoneIds": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } } } }], "unevaluatedProperties": false },
    "oneOfObjectsClue": { "allOf": [{ "$ref": "#/$defs/clueBase" }, { "type": "object", "required": ["type", "objectIds"], "properties": { "type": { "const": "oneOfObjects" }, "objectIds": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } } } }], "unevaluatedProperties": false },
    "aloneInZoneClue": { "$ref": "#/$defs/aloneInZoneClueShape", "unevaluatedProperties": false },
    "aloneInZoneClueShape": { "allOf": [{ "$ref": "#/$defs/clueBase" }, { "type": "object", "required": ["type"], "properties": { "type": { "const": "aloneInZone" } } }] },
    "notAloneInZoneClue": { "allOf": [{ "$ref": "#/$defs/clueBase" }, { "type": "object", "required": ["type"], "properties": { "type": { "const": "notAloneInZone" } } }], "unevaluatedProperties": false },
    "ownZoneOccupancyCountClue": { "allOf": [{ "$ref": "#/$defs/clueBase" }, { "type": "object", "required": ["type", "count"], "properties": { "type": { "const": "ownZoneOccupancyCount" }, "count": { "type": "integer", "minimum": 1 } } }], "unevaluatedProperties": false },
    "sameColumnAsObjectClue": { "allOf": [{ "$ref": "#/$defs/clueBase" }, { "type": "object", "required": ["type", "objectId", "zoneRelation"], "properties": { "type": { "const": "sameColumnAsObject" }, "objectId": { "$ref": "#/$defs/nonEmptyString" }, "zoneRelation": { "$ref": "#/$defs/objectZoneRelation" } } }], "unevaluatedProperties": false },
    "relativeToObjectClue": { "allOf": [{ "$ref": "#/$defs/clueBase" }, { "type": "object", "required": ["type", "objectId", "direction", "zoneRelation"], "properties": { "type": { "const": "relativeToObject" }, "objectId": { "$ref": "#/$defs/nonEmptyString" }, "direction": { "enum": ["northEast", "northWest", "southEast", "southWest"] }, "zoneRelation": { "$ref": "#/$defs/objectZoneRelation" } } }], "unevaluatedProperties": false },
    "onSurfaceClue": { "allOf": [{ "$ref": "#/$defs/clueBase" }, { "type": "object", "required": ["type", "surface"], "properties": { "type": { "const": "onSurface" }, "surface": { "$ref": "#/$defs/zoneSurface" } } }], "unevaluatedProperties": false },
    "objectZoneRelation": { "enum": ["same", "different", "any"] },
    "character": {
      "type": "object",
      "required": ["id", "name", "avatar", "clues", "isVictim"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "avatar": { "$ref": "#/$defs/nonEmptyString" },
        "avatarAsset": { "$ref": "#/$defs/assetKey" },
        "gender": { "enum": ["female", "male"] },
        "roleId": { "$ref": "#/$defs/nonEmptyString" },
        "roleLabel": { "$ref": "#/$defs/nonEmptyString" },
        "clues": { "type": "array", "items": { "$ref": "#/$defs/clue" } },
        "isVictim": { "type": "boolean" },
        "traitIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } }
      },
      "additionalProperties": false
    },
    "placement": {
      "type": "object",
      "required": ["characterId", "position"],
      "properties": {
        "characterId": { "$ref": "#/$defs/nonEmptyString" },
        "position": { "$ref": "#/$defs/position" }
      },
      "additionalProperties": false
    },
    "traitDefinition": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "label": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "edgeSegment": {
      "type": "object",
      "required": ["position", "side"],
      "properties": {
        "position": { "$ref": "#/$defs/position" },
        "side": { "enum": ["N", "E", "S", "W"] }
      },
      "additionalProperties": false
    },
    "edgeFeature": {
      "type": "object",
      "required": ["id", "type", "label", "segments"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "enum": ["window", "door"] },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "segments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/edgeSegment" } }
      },
      "additionalProperties": false
    },
    "globalClueBase": {
      "type": "object",
      "required": ["id", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "text": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "globalClue": {
      "oneOf": [
        { "allOf": [{ "$ref": "#/$defs/globalClueBase" }, { "type": "object", "required": ["type", "count"], "properties": { "type": { "const": "emptyZoneCount" }, "count": { "type": "integer", "minimum": 0 } } }], "unevaluatedProperties": false },
        { "allOf": [{ "$ref": "#/$defs/globalClueBase" }, { "type": "object", "required": ["type", "zoneId", "count"], "properties": { "type": { "const": "zoneOccupancyCount" }, "zoneId": { "$ref": "#/$defs/nonEmptyString" }, "count": { "type": "integer", "minimum": 0 } } }], "unevaluatedProperties": false },
        { "allOf": [{ "$ref": "#/$defs/globalClueBase" }, { "type": "object", "required": ["type", "objectId", "count"], "properties": { "type": { "const": "objectOccupancyCount" }, "objectId": { "$ref": "#/$defs/nonEmptyString" }, "count": { "type": "integer", "minimum": 0 } } }], "unevaluatedProperties": false },
        { "allOf": [{ "$ref": "#/$defs/globalClueBase" }, { "type": "object", "required": ["type", "zoneId", "traitId", "count"], "properties": { "type": { "const": "zoneTraitCount" }, "zoneId": { "$ref": "#/$defs/nonEmptyString" }, "traitId": { "$ref": "#/$defs/nonEmptyString" }, "count": { "type": "integer", "minimum": 0 } } }], "unevaluatedProperties": false },
        { "allOf": [{ "$ref": "#/$defs/globalClueBase" }, { "type": "object", "required": ["type", "surface", "count"], "properties": { "type": { "const": "surfaceOccupancyCount" }, "surface": { "$ref": "#/$defs/zoneSurface" }, "count": { "type": "integer", "minimum": 0 } } }], "unevaluatedProperties": false }
      ]
    }
  }
}
